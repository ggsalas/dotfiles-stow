    },
    "markdown": {
      "text": "#eee9dd",
      "heading": "#d699b6",
      "link": "#7fbbb3",
      "linkText": "#83c092",
      "code": "#83c092",
      "blockQuote": "#c0b59c",
      "emphasis": "#dbbc7f",
      "strong": "#d699b6",
      "horizontalRule": "#8a8577",
      "listItem": "#eee9dd",
      "listEnumeration": "#d699b6",
      "image": "#d699b6",
