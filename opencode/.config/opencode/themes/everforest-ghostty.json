{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "green", "blue", "purple", "yellow", "cyan", "red", "orange"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$hue.interactive.400",
          "$focused": "$hue.interactive.300",
          "$selected": "$hue.interactive.500",
          "$disabled": "$hue.neutral.600"
        },
        "secondary": {
          "base": "$hue.neutral.400",
          "$hovered": "$hue.neutral.300"
        },
        "destructive": {
          "base": "$hue.red.400",
          "$disabled": "$hue.red.500"
        }
      },
      "formfield": {
        "base": "$hue.neutral.100",
        "$hovered": "$hue.neutral.200",
        "$focused": "$hue.interactive.300",
        "$pressed": "$hue.interactive.400",
        "$selected": "$hue.interactive.300",
        "$disabled": "$hue.neutral.500"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "$hue.yellow.400"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.blue.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "$hue.interactive.600",
          "$hovered": "$hue.interactive.500",
          "$focused": "$hue.interactive.700",
          "$selected": "$hue.interactive.600"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.600"
        }
      },
      "formfield": {
        "base": "$hue.neutral.800"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.900"
        },
        "warning": {
          "base": "$hue.yellow.900"
        },
        "success": {
          "base": "$hue.green.900"
        },
        "info": {
          "base": "$hue.blue.900"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.700"
    },
    "scrollbar": {
      "base": "$hue.neutral.700"
    },
    "diff": {
      "text": {
        "added": "$hue.green.300",
        "removed": "$hue.red.300",
        "context": "$text.muted",
        "hunkHeader": "$hue.neutral.500"
      },
      "background": {
        "added": "$hue.green.900",
        "removed": "$hue.red.900",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800"
      },
      "lineNumber": {
        "text": "$hue.neutral.600",
        "background": {
          "added": "$hue.green.800",
          "removed": "$hue.red.800"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.300",
      "keyword": "$hue.purple.100",
      "function": "$hue.blue.100",
      "variable": "$hue.cyan.100",
      "string": "$hue.green.100",
      "number": "$hue.orange.100",
      "type": "$hue.yellow.100",
      "operator": "$hue.red.100",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.accent.100",
      "link": "$hue.blue.100",
      "linkText": "$hue.blue.100",
      "code": "$hue.cyan.100",
      "blockQuote": "$hue.neutral.200",
      "emphasis": "$hue.yellow.100",
      "strong": "$hue.accent.100",
      "horizontalRule": "$hue.neutral.500",
      "listItem": "$hue.neutral.100",
      "listEnumeration": "$hue.accent.100",
      "image": "$hue.purple.100",
      "imageText": "$hue.purple.100",
      "codeBlock": "$hue.neutral.100"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
